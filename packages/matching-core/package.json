{
  "name": "@solidchange/matching-core",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18 <25"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "node scripts/check-boundary.mjs",
    "lint": "biome lint src tests scripts",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "verify": "npm run check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@types/node": "24.3.0",
    "typescript": "5.9.2"
  }
}
