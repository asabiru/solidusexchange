{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.solidchange.invalid/schemas/events/domain-event.schema.json",
  "title": "SolidChange Domain Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "producer",
    "aggregate_type",
    "aggregate_id",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "actor",
    "data_classification",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "UserRegistered",
        "KycSubmitted",
        "KycVerified",
        "WalletAddressAssigned",
        "DepositDetected",
        "DepositConfirmed",
        "QuoteCreated",
        "ExchangeOrderCreated",
        "ExchangeSettled",
        "WithdrawalRequested",
        "WithdrawalHeld",
        "WithdrawalApproved",
        "WithdrawalBroadcast",
        "PaymentConfirmed",
        "PaymentRefunded",
        "AmlAlertCreated"
      ]
    },
    "event_version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "user",
        "kyc_case",
        "wallet",
        "deposit",
        "quote",
        "exchange_order",
        "withdrawal",
        "payment",
        "aml_alert"
      ]
    },
    "aggregate_id": {
      "$ref": "#/$defs/identifier"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 16,
      "maxLength": 128
    },
    "actor": {
      "$ref": "#/$defs/actor"
    },
    "data_classification": {
      "type": "string",
      "enum": [
        "confidential",
        "highly-confidential"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "UserRegistered"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "aggregate_type": {
            "const": "user"
          },
          "payload": {
            "$ref": "#/$defs/userRegistered"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "KycSubmitted"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "aggregate_type": {
            "const": "kyc_case"
          },
          "payload": {
            "$ref": "#/$defs/kycSubmitted"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "KycVerified"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "aggregate_type": {
            "const": "kyc_case"
          },
          "payload": {
            "$ref": "#/$defs/kycVerified"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "WalletAddressAssigned"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "aggregate_type": {
            "const": "wallet"
          },
          "payload": {
            "$ref": "#/$defs/walletAddressAssigned"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "DepositDetected"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "aggregate_type": {
            "const": "deposit"
          },
          "payload": {
            "$ref": "#/$defs/depositDetected"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "DepositConfirmed"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "aggregate_type": {
            "const": "deposit"
          },
          "payload": {
            "$ref": "#/$defs/depositConfirmed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "QuoteCreated"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "aggregate_type": {
            "const": "quote"
          },
          "payload": {
            "$ref": "#/$defs/quoteCreated"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "ExchangeOrderCreated"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "aggregate_type": {
            "const": "exchange_order"
          },
          "payload": {
            "$ref": "#/$defs/exchangeOrderCreated"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "ExchangeSettled"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "aggregate_type": {
            "const": "exchange_order"
          },
          "payload": {
            "$ref": "#/$defs/exchangeSettled"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "WithdrawalRequested"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "aggregate_type": {
            "const": "withdrawal"
          },
          "payload": {
            "$ref": "#/$defs/withdrawalRequested"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "WithdrawalHeld"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "aggregate_type": {
            "const": "withdrawal"
          },
          "payload": {
            "$ref": "#/$defs/withdrawalHeld"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "WithdrawalApproved"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "aggregate_type": {
            "const": "withdrawal"
          },
          "payload": {
            "$ref": "#/$defs/withdrawalApproved"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "WithdrawalBroadcast"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "aggregate_type": {
            "const": "withdrawal"
          },
          "payload": {
            "$ref": "#/$defs/withdrawalBroadcast"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "PaymentConfirmed"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "aggregate_type": {
            "const": "payment"
          },
          "payload": {
            "$ref": "#/$defs/paymentConfirmed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "PaymentRefunded"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "aggregate_type": {
            "const": "payment"
          },
          "payload": {
            "$ref": "#/$defs/paymentRefunded"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "AmlAlertCreated"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "aggregate_type": {
            "const": "aml_alert"
          },
          "payload": {
            "$ref": "#/$defs/amlAlertCreated"
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decimalAmount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "assetCode": {
      "type": "string",
      "pattern": "^[A-Z0-9]{2,16}$"
    },
    "networkCode": {
      "type": "string",
      "pattern": "^[A-Z0-9_-]{2,32}$"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "subject"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "customer",
            "operator",
            "service",
            "provider"
          ]
        },
        "subject": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "userRegistered": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "registration_channel"
      ],
      "properties": {
        "user_id": {
          "$ref": "#/$defs/identifier"
        },
        "registration_channel": {
          "type": "string",
          "enum": [
            "web",
            "ios",
            "android",
            "telegram-mini-app",
            "migration"
          ]
        }
      }
    },
    "kycSubmitted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "user_id",
        "provider_reference",
        "evidence_digest"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/identifier"
        },
        "user_id": {
          "$ref": "#/$defs/identifier"
        },
        "provider_reference": {
          "$ref": "#/$defs/identifier"
        },
        "evidence_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "kycVerified": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "user_id",
        "decision",
        "policy_version",
        "evidence_digest"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/identifier"
        },
        "user_id": {
          "$ref": "#/$defs/identifier"
        },
        "decision": {
          "type": "string",
          "enum": [
            "approved",
            "rejected",
            "manual-review"
          ]
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "evidence_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "walletAddressAssigned": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wallet_id",
        "user_id",
        "asset",
        "network",
        "address_reference",
        "custody_account_id"
      ],
      "properties": {
        "wallet_id": {
          "$ref": "#/$defs/identifier"
        },
        "user_id": {
          "$ref": "#/$defs/identifier"
        },
        "asset": {
          "$ref": "#/$defs/assetCode"
        },
        "network": {
          "$ref": "#/$defs/networkCode"
        },
        "address_reference": {
          "$ref": "#/$defs/identifier"
        },
        "custody_account_id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "depositDetected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deposit_id",
        "wallet_id",
        "asset",
        "network",
        "amount",
        "transaction_reference",
        "observed_at"
      ],
      "properties": {
        "deposit_id": {
          "$ref": "#/$defs/identifier"
        },
        "wallet_id": {
          "$ref": "#/$defs/identifier"
        },
        "asset": {
          "$ref": "#/$defs/assetCode"
        },
        "network": {
          "$ref": "#/$defs/networkCode"
        },
        "amount": {
          "$ref": "#/$defs/decimalAmount"
        },
        "transaction_reference": {
          "$ref": "#/$defs/identifier"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "depositConfirmed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deposit_id",
        "confirmations",
        "confirmed_at"
      ],
      "properties": {
        "deposit_id": {
          "$ref": "#/$defs/identifier"
        },
        "confirmations": {
          "type": "integer",
          "minimum": 1
        },
        "confirmed_at": {
          "type": "string",
          "format": "date-time"
        },
        "journal_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "quoteCreated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quote_id",
        "user_id",
        "from_asset",
        "to_asset",
        "from_amount",
        "to_amount",
        "fee_amount",
        "pricing_source",
        "expires_at"
      ],
      "properties": {
        "quote_id": {
          "$ref": "#/$defs/identifier"
        },
        "user_id": {
          "$ref": "#/$defs/identifier"
        },
        "from_asset": {
          "$ref": "#/$defs/assetCode"
        },
        "to_asset": {
          "$ref": "#/$defs/assetCode"
        },
        "from_amount": {
          "$ref": "#/$defs/decimalAmount"
        },
        "to_amount": {
          "$ref": "#/$defs/decimalAmount"
        },
        "fee_amount": {
          "$ref": "#/$defs/decimalAmount"
        },
        "pricing_source": {
          "$ref": "#/$defs/identifier"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "exchangeOrderCreated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order_id",
        "quote_id",
        "user_id",
        "status"
      ],
      "properties": {
        "order_id": {
          "$ref": "#/$defs/identifier"
        },
        "quote_id": {
          "$ref": "#/$defs/identifier"
        },
        "user_id": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "const": "created"
        }
      }
    },
    "exchangeSettled": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order_id",
        "journal_id",
        "settled_at"
      ],
      "properties": {
        "order_id": {
          "$ref": "#/$defs/identifier"
        },
        "journal_id": {
          "$ref": "#/$defs/identifier"
        },
        "settled_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "withdrawalRequested": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "withdrawal_id",
        "user_id",
        "asset",
        "network",
        "amount",
        "destination_reference"
      ],
      "properties": {
        "withdrawal_id": {
          "$ref": "#/$defs/identifier"
        },
        "user_id": {
          "$ref": "#/$defs/identifier"
        },
        "asset": {
          "$ref": "#/$defs/assetCode"
        },
        "network": {
          "$ref": "#/$defs/networkCode"
        },
        "amount": {
          "$ref": "#/$defs/decimalAmount"
        },
        "destination_reference": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "withdrawalHeld": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "withdrawal_id",
        "hold_id",
        "reason_code"
      ],
      "properties": {
        "withdrawal_id": {
          "$ref": "#/$defs/identifier"
        },
        "hold_id": {
          "$ref": "#/$defs/identifier"
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        }
      }
    },
    "withdrawalApproved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "withdrawal_id",
        "approval_id",
        "approver_count",
        "evidence_digest"
      ],
      "properties": {
        "withdrawal_id": {
          "$ref": "#/$defs/identifier"
        },
        "approval_id": {
          "$ref": "#/$defs/identifier"
        },
        "approver_count": {
          "type": "integer",
          "minimum": 1
        },
        "evidence_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "withdrawalBroadcast": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "withdrawal_id",
        "transaction_reference",
        "broadcast_at"
      ],
      "properties": {
        "withdrawal_id": {
          "$ref": "#/$defs/identifier"
        },
        "transaction_reference": {
          "$ref": "#/$defs/identifier"
        },
        "broadcast_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "paymentConfirmed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payment_id",
        "provider_reference",
        "amount",
        "currency",
        "confirmed_at"
      ],
      "properties": {
        "payment_id": {
          "$ref": "#/$defs/identifier"
        },
        "provider_reference": {
          "$ref": "#/$defs/identifier"
        },
        "amount": {
          "$ref": "#/$defs/decimalAmount"
        },
        "currency": {
          "$ref": "#/$defs/assetCode"
        },
        "confirmed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "paymentRefunded": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payment_id",
        "refund_id",
        "amount",
        "currency",
        "journal_id",
        "refunded_at"
      ],
      "properties": {
        "payment_id": {
          "$ref": "#/$defs/identifier"
        },
        "refund_id": {
          "$ref": "#/$defs/identifier"
        },
        "amount": {
          "$ref": "#/$defs/decimalAmount"
        },
        "currency": {
          "$ref": "#/$defs/assetCode"
        },
        "journal_id": {
          "$ref": "#/$defs/identifier"
        },
        "refunded_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "amlAlertCreated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alert_id",
        "user_id",
        "risk_score",
        "rule_codes"
      ],
      "properties": {
        "alert_id": {
          "$ref": "#/$defs/identifier"
        },
        "user_id": {
          "$ref": "#/$defs/identifier"
        },
        "risk_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "rule_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          }
        },
        "case_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
