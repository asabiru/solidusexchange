{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solidchange.example/schemas/financial-core/posting-command.schema.json",
  "title": "SOLID ledger posting command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "journal_id",
    "journal_type",
    "legal_entity_id",
    "idempotency_key",
    "correlation_id",
    "causation_id",
    "effective_at",
    "actor",
    "authorization_reference",
    "policy_version",
    "posting_rule_version",
    "source",
    "entries"
  ],
  "properties": {
    "journal_id": {
      "type": "string",
      "format": "uuid"
    },
    "journal_type": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "legal_entity_id": {
      "$ref": "#/$defs/identifier"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{15,127}$"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "MIGRATION_JOB",
            "OPERATOR",
            "SERVICE"
          ]
        },
        "id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "authorization_reference": {
      "$ref": "#/$defs/identifier"
    },
    "policy_version": {
      "$ref": "#/$defs/version"
    },
    "posting_rule_version": {
      "$ref": "#/$defs/version"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "reference",
        "evidence_digest"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/identifier"
        },
        "reference": {
          "$ref": "#/$defs/identifier"
        },
        "evidence_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 2,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry_id",
          "account_id",
          "asset_code",
          "side",
          "amount"
        ],
        "properties": {
          "entry_id": {
            "type": "string",
            "format": "uuid"
          },
          "account_id": {
            "type": "string",
            "format": "uuid"
          },
          "asset_code": {
            "$ref": "#/$defs/assetCode"
          },
          "side": {
            "type": "string",
            "enum": [
              "CREDIT",
              "DEBIT"
            ]
          },
          "amount": {
            "$ref": "#/$defs/decimalAmount"
          }
        }
      }
    }
  },
  "$defs": {
    "assetCode": {
      "type": "string",
      "pattern": "^[A-Z0-9]{2,12}$"
    },
    "decimalAmount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{1,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,63}$"
    }
  }
}
