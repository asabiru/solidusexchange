        {
          "definition_code": "PROVIDER_RECEIVABLE_ASSET",
          "side": "DEBIT"
        },
        {
          "definition_code": "CUSTOMER_SETTLED_LIABILITY",
          "side": "CREDIT"
        }
      ],
      "purpose": "Recognize a synthetic inbound provider position as a settled customer liability."
