# Optional overrides for the dev-only local stack. Copy to infra/local/.env
# (gitignored). Leave secret values empty: the dev-material service then
# generates fresh synthetic values at container start. Never put real
# credentials, provider keys or production values here.

# 64 lowercase hex characters, shared by customer-api and the Mini App BFF.
SOLIDCHANGE_DEV_CUSTOMER_API_TOKEN_KEY=

# 24-128 characters from [A-Za-z0-9._~-]. Only read when the audit database
# volume is first initialised; run `docker compose down -v` after changing.
SOLIDCHANGE_DEV_AUDIT_DB_SUPERUSER_PASSWORD=
SOLIDCHANGE_DEV_AUDIT_DB_RUNTIME_PASSWORD=

# Synthetic provider-simulator scenarios for the Mini App BFF.
MINIAPP_KYC_SCENARIO=approve
MINIAPP_KYT_SCENARIO=low
MINIAPP_QUOTE_SCENARIO=fresh_quote
