{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "rootDir": "src",
    "outDir": ".test-dist"
  },
  "include": [
    "src/shared/**/*.ts",
    "src/app/i18n.ts",
    "src/app/format.ts",
    "src/app/locales/*.ts",
    "src/app/i18n.test.ts",
    "src/app/a11y.test.ts",
    "src/app/checks-badges.ts",
    "src/app/checks-badges.test.ts",
    "src/app/icon-data.ts",
    "src/app/notification-seen.ts",
    "src/app/notification-seen.test.ts",
    "src/app/server-fields.ts",
    "src/app/server-fields.test.ts",
    "src/server/**/*.ts",
    "src/server/checks.test.ts",
    "src/server/notifications-routes.test.ts",
    "src/server/checks-routes.test.ts",
    "src/server/activity.test.ts",
    "src/server/activity-routes.test.ts",
    "src/server/sessions-routes.test.ts",
    "src/server/support.test.ts",
    "src/server/support-routes.test.ts"
  ]
}
