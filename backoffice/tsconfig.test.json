{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "rootDir": "src",
    "outDir": ".test-dist"
  },
  "include": [
    "src/auth/access.ts",
    "src/auth/access.test.ts",
    "src/data/demo.ts",
    "src/data/demo.test.ts",
    "src/data/provider-evidence.ts",
    "src/data/client.ts",
    "src/data/client.test.ts",
    "src/server/**/*.ts"
  ]
}
