{
  "name": "@solidchange/backoffice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:bff": "npm run build:bff && BACKOFFICE_ALLOW_DEV_LOGIN=true node .server-dist/server/index.js",
    "build": "tsc -b && npm run build:bff && vite build",
    "build:bff": "tsc -p tsconfig.server.json",
    "lint": "biome lint src scripts vite.config.ts",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.server.json --noEmit --pretty false",
    "test": "rm -rf .test-dist && tsc -p tsconfig.test.json && node --test .test-dist/app/a11y.test.js .test-dist/app/i18n.test.js .test-dist/app/checks.test.js .test-dist/app/support.test.js .test-dist/app/withdrawals.test.js .test-dist/app/subjects.test.js .test-dist/auth/access.test.js .test-dist/data/client.test.js .test-dist/data/demo.test.js .test-dist/server/checks.test.js .test-dist/server/support.test.js .test-dist/server/withdrawals.test.js .test-dist/server/subjects.test.js .test-dist/server/dev-server.test.js .test-dist/server/audit-store.test.js .test-dist/server/config.test.js .test-dist/server/controls.test.js .test-dist/server/oidc.test.js .test-dist/server/oidc-session.test.js .test-dist/server/postgres-audit-store.test.js .test-dist/server/provider-evidence.test.js .test-dist/server/reports.test.js .test-dist/server/server.test.js .test-dist/server/signing.test.js .test-dist/server/step-up.test.js .test-dist/server/observability.test.js .test-dist/server/security-headers.test.js .test-dist/server/bff-core.test.js"
  },
  "dependencies": {
    "@solidchange/provider-simulators": "file:../packages/provider-simulators",
    "pg": "8.23.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@types/node": "24.3.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "typescript": "5.9.2",
    "vite": "7.3.6"
  }
}
