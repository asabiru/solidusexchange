@import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap");

:root {
    /* eazy228/design exact color scheme */
    --color-bg: #0b0608;
    --color-bg-elevated: #150c10;
    --color-bg-gradient-from: #1a0f14;
    --color-bg-gradient-to: #3a1f2b;
    --color-border-subtle: rgba(255, 255, 255, 0.06);
    --color-border-strong: rgba(255, 255, 255, 0.12);
    --color-text-primary: #f5ede4;
    --color-text-secondary: #9a8e86;
    --color-text-muted: #5e534d;
    --color-accent: #e8c9a0;
    --color-accent-hover: #f2d8b4;
    --color-accent-soft: rgba(232, 201, 160, 0.12);
    --color-success: #e8c9a0;
    --color-warning: #d9a86a;
    --color-danger: #c9786a;

    /* Radius */
    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 16px;
    --radius-xl: 20px;
    --radius-pill: 999px;

    /* Fonts */
    --font-sans: "Inter", system-ui, -apple-system, sans-serif;
    --font-mono: "JetBrains Mono", monospace;

    /* Legacy variables for compatibility */
    --solidus-bg: #0b0608;
    --solidus-surface: #150c10;
    --solidus-surface-soft: #1a0f14;
    --solidus-border: rgba(255, 255, 255, 0.06);
    --solidus-border-strong: rgba(255, 255, 255, 0.12);
    --solidus-text: #f5ede4;
    --solidus-muted: #9a8e86;
    --solidus-accent: #e8c9a0;
    --solidus-accent-2: #f2d8b4;
    --solidus-cyan: #d4a84b;
    --solidus-shadow: 0 14px 36px rgba(11, 6, 8, 0.7);
    --solidus-body-bg: #0b0608;

    --body-font: "Inter", sans-serif;
    --heading-font: "Inter", sans-serif;
    --primary-color: #e8c9a0;
    --primary-color-rgb: 232, 201, 160;
    --secondary-color: #c9a227;
    --heading-color: #f5ede4;
    --black: #f5ede4;
    --body-color: #9a8e86;
    --grayish-blue: #c4b49a;
    --bg-color1: #0b0608;
    --bg-color2: #150c10;
    --bg-color3: #1a0f14;
    --input-color: #150c10;
    --btn-hover-bg: #f2d8b4;
    --bs-primary: #e8c9a0;
    --bs-primary-rgb: 232, 201, 160;
    --bs-link-color: #e8c9a0;
    --bs-link-hover-color: #ffffff;
}

html,
body {
    background: var(--color-bg);
    color: var(--color-text-primary);
    font-family: var(--font-sans);
    font-feature-settings: "ss01", "cv11";
}

/* Admin area: let admin theme handle its own background */
body.has-navbar-vertical-aside {
    background: var(--admin-bg, var(--color-bg));
}

body {
    font-variant-numeric: tabular-nums;
}

.tabular {
    font-variant-numeric: tabular-nums;
}

::selection {
    background: var(--color-accent);
    color: var(--color-bg);
}

@keyframes ticker-scroll {
    from {
        transform: translateX(0);
    }
    to {
        transform: translateX(-50%);
    }
}

.ticker-track {
    animation: ticker-scroll 25s linear infinite;
    will-change: transform;
}

.ticker-pause:hover .ticker-track {
    animation-play-state: paused;
}

.ticker-pause:active .ticker-track {
    animation-play-state: paused;
}

@keyframes subtle-grain {
    0%, 100% {
        opacity: 0.04;
    }
    50% {
        opacity: 0.05;
    }
}

.hero-grid {
    background-image:
        linear-gradient(to right, rgba(255, 255, 255, 0.025) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
}

/* Focus ring (accessibility) */
:focus-visible {
    outline: 1.5px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 4px;
}

/* Legacy styles for compatibility — scoped to frontend only via :not() */
:is(body:not(.has-navbar-vertical-aside)) h1,
:is(body:not(.has-navbar-vertical-aside)) h2,
:is(body:not(.has-navbar-vertical-aside)) h3,
:is(body:not(.has-navbar-vertical-aside)) h4,
:is(body:not(.has-navbar-vertical-aside)) h5,
:is(body:not(.has-navbar-vertical-aside)) h6,
.section-title,
.widget-title,
.pagetitle h3,
.nav-link-title,
.dropdown-header,
.navbar-brand {
    color: var(--color-text-primary);
    font-family: var(--font-sans);
    font-weight: 600;
}

/* Scope text color overrides to frontend only */
body:not(.has-navbar-vertical-aside) p,
body:not(.has-navbar-vertical-aside) small,
body:not(.has-navbar-vertical-aside) label,
body:not(.has-navbar-vertical-aside) .text-muted,
body:not(.has-navbar-vertical-aside) .text-body,
body:not(.has-navbar-vertical-aside) .card-text {
    color: var(--color-text-secondary) !important;
}

a {
    color: var(--color-accent);
}

a:hover,
a:focus {
    color: var(--color-accent-hover);
}

.text-primary,
.link-primary,
.link-primary:hover,
.link-primary:focus,
.link-primary:active {
    color: var(--color-accent) !important;
}

.bg-primary,
.badge.bg-primary {
    background-color: var(--color-accent) !important;
    border-color: var(--color-accent) !important;
}

.border-primary {
    border-color: var(--color-accent) !important;
}

/* Card & surface styles — scoped to frontend only */
body:not(.has-navbar-vertical-aside) .card,
body:not(.has-navbar-vertical-aside) .cmn-box,
body:not(.has-navbar-vertical-aside) .box-card,
.cmn-box,
.box-card,
.message-wrapper .messages-box,
.footer-inner-section,
.offer-banner-seciton,
.mobile-offer-banner {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    box-shadow: var(--solidus-shadow);
}

body:not(.has-navbar-vertical-aside) .card,
body:not(.has-navbar-vertical-aside) .cmn-box,
body:not(.has-navbar-vertical-aside) .box-card,
body:not(.has-navbar-vertical-aside) .dropdown-menu,
body:not(.has-navbar-vertical-aside) .modal-content,
body:not(.has-navbar-vertical-aside) .accordion-item,
body:not(.has-navbar-vertical-aside) .table-responsive,
.cmn-box,
.box-card,
.message-wrapper .messages-box,
.footer-inner-section,
.offer-banner-seciton,
.mobile-offer-banner {
    border-radius: var(--radius-lg);
}

/* Frontend navbar/sidebar only — NOT admin */
body:not(.has-navbar-vertical-aside) .navbar,
body:not(.has-navbar-vertical-aside) #header,
body:not(.has-navbar-vertical-aside) .header,
body:not(.has-navbar-vertical-aside) .sidebar,
body:not(.has-navbar-vertical-aside) #sidebar,
body:not(.has-navbar-vertical-aside) .bottom-nav {
    backdrop-filter: blur(8px);
    border-radius: 0;
}

body:not(.has-navbar-vertical-aside) .navbar-brand img,
body:not(.has-navbar-vertical-aside) .logo img,
body:not(.has-navbar-vertical-aside) .navbar-brand-logo,
body:not(.has-navbar-vertical-aside) .navbar-brand-logo-mini,
body:not(.has-navbar-vertical-aside) #logoSet,
body:not(.has-navbar-vertical-aside) #logoSetMobile {
    filter: drop-shadow(0 0 12px rgba(232, 201, 160, 0.55));
}

/* Frontend nav links only */
body:not(.has-navbar-vertical-aside) .navbar .nav-link,
body:not(.has-navbar-vertical-aside) .navbar-vertical .nav-link,
body:not(.has-navbar-vertical-aside) .sidebar .nav-link,
body:not(.has-navbar-vertical-aside) .navbar .dropdown-item,
body:not(.has-navbar-vertical-aside) .header-nav .nav-link,
body:not(.has-navbar-vertical-aside) .sidebar-nav .nav-link span,
body:not(.has-navbar-vertical-aside) .sidebar-nav .nav-link i,
body:not(.has-navbar-vertical-aside) .navbar .navbar-brand,
body:not(.has-navbar-vertical-aside) .dropdown-item {
    color: var(--color-text-primary) !important;
}

body:not(.has-navbar-vertical-aside) .navbar .nav-link:hover,
body:not(.has-navbar-vertical-aside) .navbar .nav-link.active,
body:not(.has-navbar-vertical-aside) .navbar-vertical .nav-link:hover,
body:not(.has-navbar-vertical-aside) .navbar-vertical .nav-link.active,
body:not(.has-navbar-vertical-aside) .sidebar .nav-link:hover,
body:not(.has-navbar-vertical-aside) .sidebar .nav-link.active,
body:not(.has-navbar-vertical-aside) .dropdown-item:hover,
body:not(.has-navbar-vertical-aside) .dropdown-item:focus,
body:not(.has-navbar-vertical-aside) .bottom-nav .nav-item .nav-link.active,
body:not(.has-navbar-vertical-aside) .bottom-nav .nav-item .nav-link:hover {
    color: var(--color-bg) !important;
    background: var(--color-accent) !important;
    border-color: var(--color-border-strong) !important;
    box-shadow: 0 8px 20px rgba(232, 201, 160, 0.32);
    border-radius: var(--radius-md);
}

/* Admin sidebar: keep active state subtle and prevent oversized beige blocks */
.navbar-vertical-aside .sidebar .nav-link.active,
.navbar-vertical-aside .sidebar .nav-link.dropdown-toggle.active,
.navbar-vertical-aside .sidebar .nav-link[aria-expanded="true"] {
    color: var(--admin-text-primary, var(--color-text-primary)) !important;
    background: rgba(232, 201, 160, 0.10) !important;
    border-color: rgba(232, 201, 160, 0.18) !important;
    box-shadow: none !important;
    border-radius: 12px !important;
    transform: none !important;
}

.navbar-vertical-aside .sidebar .nav-link.active:hover,
.navbar-vertical-aside .sidebar .nav-link.dropdown-toggle.active:hover,
.navbar-vertical-aside .sidebar .nav-link[aria-expanded="true"]:hover {
    color: var(--admin-text-primary, var(--color-text-primary)) !important;
    background: rgba(232, 201, 160, 0.14) !important;
    box-shadow: none !important;
}

/* Buttons — frontend only overrides */
body:not(.has-navbar-vertical-aside) .btn,
body:not(.has-navbar-vertical-aside) .cmn-btn,
body:not(.has-navbar-vertical-aside) .cmn-btn2,
body:not(.has-navbar-vertical-aside) .cmn-btn3,
body:not(.has-navbar-vertical-aside) .login-btn,
body:not(.has-navbar-vertical-aside) .offer-btn {
    background: var(--color-accent) !important;
    border: 1px solid var(--color-border-strong) !important;
    color: var(--color-bg) !important;
    border-radius: var(--radius-md);
    box-shadow: 0 10px 24px rgba(232, 201, 160, 0.34);
    font-weight: 500;
}

body:not(.has-navbar-vertical-aside) .btn:hover,
body:not(.has-navbar-vertical-aside) .cmn-btn:hover,
body:not(.has-navbar-vertical-aside) .cmn-btn2:hover,
body:not(.has-navbar-vertical-aside) .cmn-btn3:hover,
body:not(.has-navbar-vertical-aside) .login-btn:hover,
body:not(.has-navbar-vertical-aside) .offer-btn:hover {
    background: var(--color-accent-hover) !important;
    box-shadow: 0 10px 30px rgba(232, 201, 160, 0.5);
    transform: translateY(-2px);
}

/* Form controls — frontend only overrides */
body:not(.has-navbar-vertical-aside) .form-control,
body:not(.has-navbar-vertical-aside) .form-select {
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    color: var(--color-text-primary);
    border-radius: var(--radius-md);
}

body:not(.has-navbar-vertical-aside) .form-control:focus,
body:not(.has-navbar-vertical-aside) .form-select:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(232, 201, 160, 0.15);
    background-color: var(--color-bg);
    outline: none;
}

body:not(.has-navbar-vertical-aside) .form-control::placeholder {
    color: var(--color-text-muted);
}

.select2-dropdown {
    background-color: var(--color-bg-elevated);
    border-color: var(--color-border-subtle);
}

.select2-container--default .select2-selection--single {
    background-color: var(--color-bg-elevated);
    border-color: var(--color-border-subtle);
}

.select2-container--default .select2-selection--single .select2-selection__rendered {
    color: var(--color-text-primary);
}

.select2-container .select2-dropdown .select2-search__field {
    background-color: var(--color-bg);
    color: var(--color-text-primary);
    border-color: var(--color-border-subtle);
}

.offcanvas {
    border-radius: 0 !important;
}

.newsletter-section {
    position: relative;
    padding: 72px 0;
    background:
        radial-gradient(circle at 14% 16%, rgba(232, 201, 160, 0.16), transparent 34%),
        radial-gradient(circle at 85% 80%, rgba(76, 37, 26, 0.20), transparent 38%),
        linear-gradient(135deg, #0b0608 0%, #160b10 52%, #070405 100%) !important;
    background-image: none !important;
    overflow: hidden;
    border-top: 1px solid rgba(232, 201, 160, 0.10);
    border-bottom: 1px solid rgba(232, 201, 160, 0.08);
}

.newsletter-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
        linear-gradient(rgba(232, 201, 160, 0.055) 1px, transparent 1px),
        linear-gradient(90deg, rgba(232, 201, 160, 0.055) 1px, transparent 1px);
    background-size: 64px 64px;
    pointer-events: none;
    opacity: 0.85;
    mask-image: radial-gradient(ellipse at center, rgba(0,0,0,1) 30%, rgba(0,0,0,0) 78%);
}

.newsletter-section .container {
    position: relative;
    z-index: 1;
}

.newsletter-section .content-area {
    position: relative;
    z-index: 1;
    max-width: 820px;
    margin: 0 auto;
    padding: 28px;
    border-radius: 26px;
    border: 1px solid rgba(232, 201, 160, 0.18);
    background: rgba(18, 9, 13, 0.72) !important;
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.42), inset 0 1px 0 rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(18px);
    text-align: center;
}

.newsletter-section .content-area,
.newsletter-section .content-area p {
    color: #d9cab8 !important;
    line-height: 1.45;
    text-transform: none;
}

.newsletter-section .content-area .subscribe-normal-text {
    margin: 0;
    color: #fff6ea !important;
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 850;
    letter-spacing: -0.04em;
    line-height: 1.05;
    text-shadow: 0 1px 18px rgba(0, 0, 0, 0.45);
}

.newsletter-section .content-area .subscribe-small-text {
    margin-top: 10px;
    margin-bottom: 0;
    color: rgba(245, 237, 228, 0.82) !important;
    font-size: 15px;
    line-height: 1.6;
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
}

.newsletter-section .newsletter-form {
    max-width: 680px;
    margin: 18px auto 0;
    position: static;
    display: flex;
    align-items: stretch;
    gap: 12px;
}

.newsletter-section .newsletter-form .form-control {
    flex: 1;
    height: 56px;
    padding: 0 16px;
    border-radius: 16px;
    background: #0b0608;
    border: 1px solid rgba(232, 201, 160, 0.22);
    color: #f5ede4;
}

.newsletter-section .newsletter-form .form-control:focus {
    border-color: #e8c9a0;
    box-shadow: 0 0 0 4px rgba(232, 201, 160, 0.08);
}

.newsletter-section .newsletter-form .subscribe-btn {
    position: static;
    height: 56px;
    border-radius: 16px;
    padding: 0 22px;
    border: 1px solid rgba(232, 201, 160, 0.25);
    background: linear-gradient(135deg, #e8c9a0, #f2d8b4);
    color: #0b0608;
    font-weight: 850;
    white-space: nowrap;
    box-shadow: 0 14px 30px rgba(232, 201, 160, 0.18);
}

.newsletter-section .newsletter-form .subscribe-btn:hover {
    background: linear-gradient(135deg, #f2d8b4, #e8c9a0);
    color: #0b0608;
}

.newsletter-section .newsletter-thumbs,
.newsletter-section .newsletter-thumbs img {
    display: none !important;
}

@media (max-width: 991px) {
    .newsletter-section {
        padding: 56px 0;
    }

    .newsletter-section .content-area {
        padding: 22px;
        border-radius: 24px;
    }

    .newsletter-section .newsletter-form {
        justify-content: center;
    }
}

@media (max-width: 575px) {
    .newsletter-section {
        padding: 44px 0;
    }

    .newsletter-section .content-area {
        padding: 18px;
        border-radius: 22px;
    }

    .newsletter-section .newsletter-form {
        flex-direction: column;
        gap: 10px;
    }

    .newsletter-section .newsletter-form .form-control {
        height: 52px;
        border-radius: 14px;
    }

    .newsletter-section .newsletter-form .subscribe-btn {
        width: 100%;
        height: 52px;
        border-radius: 14px;
    }
}
