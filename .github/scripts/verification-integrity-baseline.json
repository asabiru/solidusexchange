      "typecheck": "tsc -b --pretty false && tsc -p tsconfig.server.json --noEmit --pretty false",
      "test": "rm -rf .test-dist && tsc -p tsconfig.test.json && node --test .test-dist/auth/access.test.js .test-dist/data/client.test.js .test-dist/data/demo.test.js .test-dist/server/dev-server.test.js .test-dist/server/audit-store.test.js .test-dist/server/config.test.js .test-dist/server/controls.test.js .test-dist/server/oidc.test.js .test-dist/server/oidc-session.test.js .test-dist/server/postgres-audit-store.test.js .test-dist/server/provider-evidence.test.js .test-dist/server/reports.test.js .test-dist/server/server.test.js .test-dist/server/signing.test.js .test-dist/server/step-up.test.js"
    },
    "miniapp/package.json": {
      "dev": "node scripts/dev.mjs",
      "dev:web": "vite",
      "dev:bff": "npm run build:bff && MINIAPP_ALLOW_DEV_LOGIN=true node .server-dist/server/index.js",
      "build": "tsc -b && npm run build:bff && vite build",
      "build:bff": "tsc -p tsconfig.server.json",
      "lint": "biome lint src scripts vite.config.ts",
      "typecheck": "tsc -b --pretty false && tsc -p tsconfig.server.json --noEmit --pretty false",
      "test": "rm -rf .test-dist && tsc -p tsconfig.test.json && node --test .test-dist/shared/decimal.test.js .test-dist/shared/quote.test.js .test-dist/server/init-data.test.js .test-dist/server/quotes.test.js .test-dist/server/provider-quotes.test.js .test-dist/server/kyc.test.js .test-dist/server/kyc-routes.test.js .test-dist/server/bff-security.test.js .test-dist/server/notifications.test.js .test-dist/server/customer-api-client.test.js .test-dist/server/integration.test.js .test-dist/server/server.test.js .test-dist/server/dev-server.test.js"
    },
    "packages/api-contracts/package.json": {
      "check": "node scripts/check-contracts.mjs",
      "test": "npm run check && node --test tests/*.test.mjs"
    },
    "packages/custody-core/package.json": {
      "check": "node scripts/check-boundary.mjs",
      "test": "node --test tests/*.test.mjs",
      "verify": "npm run check && npm run verify:migrations && npm test",
      "verify:migrations": "node scripts/verify-postgres-migration-source-catalog.mjs && node scripts/verify-postgres-migration-source-policy.mjs"
    },
    "packages/customer-api/package.json": {
      "check": "node scripts/check-boundary.mjs",
      "dev": "node src/server.mjs",
      "mint-dev-token": "node scripts/mint-dev-token.mjs",
      "test": "npm run check && node --test tests/*.test.mjs"
    },
    "packages/e2e-dev/package.json": {
      "build": "npm --prefix ../../miniapp run build:bff && npm --prefix ../../backoffice run build:bff",
      "lint": "node --check tests/stack.mjs && node --check tests/dev-stack.test.mjs && node --check tests/boundaries.test.mjs",
      "test": "npm run build && node --test tests/dev-stack.test.mjs tests/boundaries.test.mjs",
      "typecheck": "npm run lint"
    },
    "packages/financial-core/package.json": {
      "check": "node scripts/check-foundation.mjs",
      "test": "node --test tests/*.test.mjs",
      "verify": "npm run check && npm run verify:migrations && npm test",
      "verify:migrations": "node scripts/verify-postgres-migration-source-catalog.mjs && node scripts/verify-postgres-migration-source-policy.mjs"
    },
    "packages/provider-simulators/package.json": {
      "build": "rm -rf dist && tsc -p tsconfig.build.json",
      "check": "node scripts/check-boundary.mjs",
      "lint": "biome lint src tests scripts",
      "test": "node --test tests/*.test.mjs",
      "typecheck": "tsc -p tsconfig.json --pretty false",
      "verify": "npm run check && npm run lint && npm run typecheck && npm test && npm run build"
    }
